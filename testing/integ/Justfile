# @author  Forrest Jablonski
#

default_build_dir := "build"
default_target := "all"

build tar=default_target:
   @if [ ! -f "{{default_build_dir}}/CMakeCache.txt" ]; then \
      cmake -S . --preset test; \
   fi
   cmake --build {{default_build_dir}} --target {{tar}}

rebuild tar=default_target:
   just clean-all
   just build {{tar}}

run tar=default_target:
   python run_test.py \
      --testdir /home/forrest/code/ym/testing/integ \
      --projdir /home/forrest/code \
      --builddir /home/forrest/code/ym/testing/integ/build \
      --suitename core.file_handling \
      --libname libinteg.core.file_handling-tests.so

clean dir=default_build_dir:
   cmake --build {{dir}} --target clean

clean-all dir=default_build_dir:
   @rm -rf {{dir}}
