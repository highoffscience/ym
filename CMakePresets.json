{
   "version": 7,
   "cmakeMinimumRequired": {
      "major": 3,
      "minor": 27,
      "patch": 0
   },
   "configurePresets": [
      {
         "name": "docs",
         "displayName": "doxygen",
         "generator": "Ninja",
         "binaryDir": "${sourceDir}/build",
         "toolchainFile": "${sourceDir}/toolchain.cmake",
         "cacheVariables": {
            "YM_ExtLibsDir": "${sourceDir}/extlibs"
         }
      }
   ]
}
